---
const features = [
  {
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" /></svg>`,
    title: 'Registro instantáneo de paquetes',
    description: 'Ingresa cada paquete al recibirlo — con código de tracking, tipo y precio. Queda guardado al instante, sin papel, sin riesgo de pérdida.',
  },
  {
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>`,
    title: 'Inventario con filtros avanzados',
    description: 'Filtra por delivery, cliente, tipo de paquete o día. Ve el estado de cada paquete — pendiente, en ruta o entregado — en segundos.',
  },
  {
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>`,
    title: 'Dashboard de ganancias en tiempo real',
    description: 'Ve cuánto ganaste hoy, cómo vas versus ayer y qué repartidores rindieron más. Sin abrir Excel, sin hacer cuentas.',
  },
  {
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" /></svg>`,
    title: 'Estado de cuenta por cliente',
    description: 'Entra a cualquier cliente y ve cuánto te debe, qué paquetes están pendientes de cobro y genera un reporte imprimible para cobrar en el momento.',
    highlight: true,
  },
  {
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`,
    title: 'Gestión de repartidores y clientes',
    description: 'Agrega tu equipo de deliverys, asigna paquetes con un clic y administra tus clientes. Todo el control en un solo lugar.',
  },
  {
    icon: `<svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>`,
    title: 'Celular, tablet o computador',
    description: 'Registra paquetes desde la bodega con el celular. Revisa el dashboard desde el PC en la oficina. Todo sincronizado en tiempo real.',
  },
];
---

<section id="caracteristicas" class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary">La solución</p>
      <h2 class="text-3xl font-bold sm:text-4xl">
        Todo lo que necesita tu operación
        <span class="text-primary">en un solo lugar</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-text">
        MoviPacks reemplaza el papel, el Excel y el WhatsApp con un sistema pensado para operadores FLEX.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map(feature => (
        <div class={`group rounded-xl border p-6 transition-all duration-200 ${
          feature.highlight
            ? 'border-primary/40 bg-dark-card ring-1 ring-primary/20 hover:border-primary/70'
            : 'border-dark-border bg-dark-card hover:border-primary/30'
        }`}>
          {feature.highlight && (
            <div class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-primary/15 px-2.5 py-1 text-xs font-semibold text-primary">
              <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="4"/></svg>
              Nuevo
            </div>
          )}
          <div class={`mb-4 flex h-12 w-12 items-center justify-center rounded-lg transition-colors ${
            feature.highlight ? 'bg-primary/15 text-primary' : 'bg-primary/10 text-primary group-hover:bg-primary/15'
          }`}>
            <Fragment set:html={feature.icon} />
          </div>
          <h3 class="mb-2 text-lg font-semibold text-white">{feature.title}</h3>
          <p class="text-sm leading-relaxed text-gray-text">{feature.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
