---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:3000';

const features = [
  'Paquetes ilimitados',
  'Clientes ilimitados',
  'Repartidores ilimitados',
  'Dashboard de operación diaria',
  'Reportes semanales y mensuales',
  'Pick UP delivery',
  'Soporte dedicado',
];
---

<section id="precios" class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary">Precio</p>
      <h2 class="text-3xl font-bold sm:text-4xl">
        Prueba todo
        <span class="text-primary">gratis por 7 días</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-text">
        Sin tarjeta de crédito. Al terminar la prueba, conversamos contigo para armar el plan que se ajuste a tu operación.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-md">
      <div class="relative rounded-2xl border border-primary/40 bg-dark-card p-8 shadow-xl shadow-primary/5 ring-1 ring-primary/10">

        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full bg-primary px-5 py-1.5 text-xs font-bold text-dark shadow-lg shadow-primary/30">
          Prueba gratuita &middot; 7 días
        </div>

        <div class="mb-1 mt-2 text-center text-lg font-bold text-white">MoviPacks</div>
        <p class="mb-6 text-center text-xs text-gray-text">Un solo plan, sin límites visibles.</p>

        <ul class="mb-8 flex flex-col gap-2.5">
          {features.map((feature) => (
            <li class="flex items-start gap-2.5 text-sm text-gray-300">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {feature}
            </li>
          ))}
        </ul>

        <a
          href={`${APP_URL}/setup`}
          class="block w-full rounded-xl bg-primary py-3.5 text-center text-base font-bold text-dark shadow-lg shadow-primary/20 transition-all hover:bg-primary-hover hover:shadow-primary/30"
        >
          Comenzar prueba gratuita
        </a>

        <p class="mt-4 text-center text-xs text-gray-text">
          Precio a medida &middot; Se define al cerrar tu plan &middot; Cancela cuando quieras
        </p>
      </div>
    </div>

  </div>
</section>
