---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:3000';

const plans = [
  {
    name: 'Trial',
    badge: 'Gratis · 7 días',
    price: null,
    priceLabel: '$0',
    priceSuffix: '/7 días',
    description: 'Prueba completa sin tarjeta de crédito.',
    features: [
      'Hasta 50 paquetes por día',
      'Hasta 2 clientes activos',
      'Hasta 2 repartidores activos',
      'Dashboard de operación diaria',
      'Acceso desde celular y computador',
    ],
    cta: 'Comenzar prueba gratuita',
    highlight: false,
  },
  {
    name: 'Basic',
    badge: null,
    price: 19990,
    priceLabel: '$19.990',
    priceSuffix: '/mes',
    description: 'Perfecto para comenzar tu operación FLEX.',
    features: [
      'Hasta 30 paquetes por día',
      '2 clientes activos',
      '2 repartidores activos',
      'Dashboard de operación diaria',
      'Soporte por email',
    ],
    cta: 'Empezar con Basic',
    highlight: false,
  },
  {
    name: 'Pro',
    badge: 'Más popular',
    price: 49990,
    priceLabel: '$49.990',
    priceSuffix: '/mes',
    description: 'Para operadores que ya escalan su volumen.',
    features: [
      'Hasta 80 paquetes por día',
      '10 clientes activos',
      '10 repartidores activos',
      'Dashboard de operación diaria',
      'Reportes semanales y mensuales',
      'Soporte prioritario (24h)',
    ],
    cta: 'Empezar con Pro',
    highlight: true,
  },
  {
    name: 'Premium',
    badge: null,
    price: 99990,
    priceLabel: '$99.990',
    priceSuffix: '/mes',
    description: 'Operación sin límites para grandes operadores.',
    features: [
      'Paquetes ilimitados',
      '50 clientes activos',
      '50 repartidores activos',
      'Dashboard de operación diaria',
      'Reportes semanales y mensuales',
      'Pick UP delivery',
      'Soporte dedicado',
    ],
    cta: 'Empezar con Premium',
    highlight: false,
  },
];
---

<section id="precios" class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary">Precios</p>
      <h2 class="text-3xl font-bold sm:text-4xl">
        Prueba todo
        <span class="text-primary">gratis por 7 días</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-text">
        Sin tarjeta de crédito. Después elige el plan que se adapta a tu operación.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {plans.map((plan) => (
        <div class={`relative flex flex-col rounded-2xl border p-6 transition-all ${
          plan.highlight
            ? 'border-primary/50 bg-dark-card shadow-xl shadow-primary/10 ring-1 ring-primary/20'
            : 'border-white/10 bg-dark-card'
        }`}>

          {plan.badge && (
            <div class={`absolute -top-3.5 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full px-4 py-1 text-xs font-bold shadow-lg ${
              plan.highlight
                ? 'bg-primary text-dark shadow-primary/30'
                : 'bg-white/10 text-white'
            }`}>
              {plan.badge}
            </div>
          )}

          <div class="mb-1 mt-2 text-lg font-bold text-white">{plan.name}</div>
          <p class="mb-4 text-xs text-gray-text">{plan.description}</p>

          <div class="mb-6 flex items-end gap-1">
            <span class="text-3xl font-bold text-white">{plan.priceLabel}</span>
            <span class="mb-0.5 text-sm text-gray-text">{plan.priceSuffix}</span>
          </div>

          <ul class="mb-6 flex flex-1 flex-col gap-2.5">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-sm text-gray-300">
                <svg class={`mt-0.5 h-4 w-4 shrink-0 ${plan.highlight ? 'text-primary' : 'text-primary/70'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {feature}
              </li>
            ))}
          </ul>

          <a
            href={`${APP_URL}/setup`}
            class={`block w-full rounded-xl py-3 text-center text-sm font-bold transition-all ${
              plan.highlight
                ? 'bg-primary text-dark shadow-lg shadow-primary/20 hover:bg-primary-hover'
                : 'border border-white/15 text-white hover:border-white/30 hover:bg-white/5'
            }`}
          >
            {plan.cta}
          </a>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-gray-text">
      Sin contrato de permanencia &middot; Cancela cuando quieras &middot; Precios en CLP
    </p>

  </div>
</section>
