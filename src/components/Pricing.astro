---
const APP_URL = 'https://app.TUDOMINIO.com';

const features = [
  'Paquetes ilimitados',
  'Repartidores ilimitados',
  'Clientes ilimitados',
  'Dashboard de ganancias en tiempo real',
  'Inventario con filtros avanzados',
  'Asignación de paquetes a repartidores',
  'Estado de cuenta por cliente',
  'Reporte de cobranza imprimible',
  'Acceso desde celular y computador',
];
---

<section id="precios" class="py-16 sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <div class="text-center">
      <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-primary">Precio</p>
      <h2 class="text-3xl font-bold sm:text-4xl">
        Prueba todo
        <span class="text-primary">gratis por 7 días</span>
      </h2>
      <p class="mx-auto mt-4 max-w-2xl text-gray-text">
        Acceso completo a todas las funcionalidades desde el primer día.
        Sin tarjeta de crédito, sin compromiso.
      </p>
    </div>

    <div class="mx-auto mt-12 max-w-md">
      <div class="relative rounded-2xl border border-primary/40 bg-dark-card p-8 shadow-xl shadow-primary/5 ring-1 ring-primary/10">

        <!-- Badge -->
        <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 rounded-full bg-primary px-5 py-1.5 text-xs font-bold text-dark shadow-lg shadow-primary/30">
          Prueba gratuita &middot; 7 días
        </div>

        <!-- Price -->
        <div class="mt-2 text-center">
          <div class="flex items-end justify-center gap-1">
            <span class="text-5xl font-bold text-white">$0</span>
            <span class="mb-1.5 text-gray-text">/7 días</span>
          </div>
          <p class="mt-1 text-sm text-gray-text">Acceso completo sin restricciones</p>
        </div>

        <!-- Feature list -->
        <ul class="mt-8 space-y-3">
          {features.map(feature => (
            <li class="flex items-center gap-3 text-sm text-gray-300">
              <svg class="h-4 w-4 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {feature}
            </li>
          ))}
        </ul>

        <!-- CTA -->
        <a
          href={`${APP_URL}`}
          class="mt-8 block w-full rounded-xl bg-primary py-3.5 text-center text-base font-bold text-dark shadow-lg shadow-primary/20 transition-all hover:bg-primary-hover hover:shadow-primary/30"
        >
          Comenzar prueba gratuita
        </a>

        <p class="mt-4 text-center text-xs text-gray-text">
          Sin tarjeta de crédito &middot; Sin compromiso &middot; Cancela cuando quieras
        </p>
      </div>

      <!-- Note about future pricing -->
      <p class="mt-5 text-center text-sm text-gray-text">
        Los planes de precios serán anunciados próximamente.<br />
        Los primeros operadores tendrán condiciones especiales.
      </p>
    </div>

  </div>
</section>
