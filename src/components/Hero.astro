---
const APP_URL = 'https://movipack.app';
---

<section class="relative overflow-hidden pt-24 pb-20 sm:pt-32 sm:pb-28">
  <!-- Background gradients -->
  <div class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 right-0 h-[600px] w-[600px] rounded-full bg-primary/6 blur-3xl"></div>
    <div class="absolute top-1/2 left-1/4 h-[300px] w-[300px] -translate-y-1/2 rounded-full bg-primary/3 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-20">

      <!-- ── Text ──────────────────────────────────────────────────────────── -->
      <div class="text-center lg:text-left">

        <!-- Badge -->
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-primary/30 bg-primary/10 px-4 py-1.5 text-sm font-medium text-primary">
          <svg class="h-3.5 w-3.5" fill="currentColor" viewBox="0 0 8 8">
            <circle cx="4" cy="4" r="4" />
          </svg>
          Hecho para operadores FLEX de Mercado Libre
        </div>

        <!-- H1 -->
        <h1 class="text-4xl font-bold leading-[1.1] tracking-tight text-white sm:text-5xl lg:text-6xl">
          Para de cerrar el día<br />
          sin saber cuánto<br />
          <span class="text-primary">ganaste</span>
        </h1>

        <!-- Sub -->
        <p class="mt-6 text-lg leading-relaxed text-gray-text sm:text-xl">
          Controla cada paquete, cada delivery y cuánto te debe cada cliente.
          Todo desde tu celular o computador, en tiempo real.
        </p>

        <!-- CTA único -->
        <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row lg:justify-start">
          <a
            href={`${APP_URL}/register`}
            class="w-full rounded-xl bg-primary px-8 py-4 text-center text-base font-bold text-dark shadow-lg shadow-primary/25 transition-all hover:bg-primary-hover hover:shadow-xl hover:shadow-primary/35 sm:w-auto"
          >
            Empieza gratis — 7 días sin compromiso
          </a>
        </div>

        <!-- Trust signals -->
        <div class="mt-5 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 lg:justify-start">
          {[
            'Sin tarjeta de crédito',
            'Configura en 5 minutos',
            'Cancela cuando quieras',
          ].map(signal => (
            <span class="flex items-center gap-1.5 text-sm text-gray-text">
              <svg class="h-3.5 w-3.5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {signal}
            </span>
          ))}
        </div>
      </div>

      <!-- ── Dashboard mockup ───────────────────────────────────────────────── -->
      <div class="relative mx-auto w-full max-w-lg lg:max-w-none">

        <!-- Glow behind mockup -->
        <div class="absolute -inset-6 -z-10 rounded-3xl bg-primary/8 blur-2xl"></div>

        <div class="rounded-2xl border border-dark-border bg-dark-card p-4 shadow-2xl ring-1 ring-white/5">

          <!-- Window chrome -->
          <div class="mb-4 flex items-center gap-3 rounded-lg bg-dark px-4 py-2.5">
            <div class="flex gap-1.5">
              <div class="h-3 w-3 rounded-full bg-red-500/70"></div>
              <div class="h-3 w-3 rounded-full bg-yellow-500/70"></div>
              <div class="h-3 w-3 rounded-full bg-green-500/70"></div>
            </div>
            <span class="flex-1 text-center text-xs text-gray-text">MoviPacks — Dashboard</span>
          </div>

          <!-- Stats row — 4 metrics -->
          <div class="mb-3 grid grid-cols-4 gap-2">
            <div class="rounded-lg bg-dark p-3 text-center">
              <p class="text-xl font-bold text-primary">142</p>
              <p class="mt-0.5 text-[10px] leading-tight text-gray-text">Paquetes<br/>hoy</p>
            </div>
            <div class="rounded-lg bg-dark p-3 text-center">
              <p class="text-xl font-bold text-green-400">128</p>
              <p class="mt-0.5 text-[10px] leading-tight text-gray-text">Entre&shy;gados</p>
            </div>
            <div class="col-span-2 rounded-lg bg-dark p-3">
              <p class="text-xl font-bold text-white">$84.500</p>
              <p class="mt-0.5 text-[10px] text-gray-text">Ganancia del día</p>
              <div class="mt-2 flex items-center gap-1 text-[10px] text-green-400">
                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
                +12% vs ayer
              </div>
            </div>
          </div>

          <!-- Por cobrar highlight -->
          <div class="mb-3 flex items-center justify-between rounded-lg border border-red-500/20 bg-red-500/5 px-3 py-2">
            <div class="flex items-center gap-2">
              <div class="h-1.5 w-1.5 rounded-full bg-red-400"></div>
              <span class="text-xs font-medium text-gray-text">Por cobrar a clientes</span>
            </div>
            <span class="text-sm font-bold text-red-400">$124.000</span>
          </div>

          <!-- Package table -->
          <div class="rounded-lg bg-dark overflow-hidden">
            <div class="grid grid-cols-4 gap-2 border-b border-dark-border px-3 py-2 text-[10px] font-semibold uppercase tracking-wider text-gray-text">
              <span>Paquete</span>
              <span>Delivery</span>
              <span>Estado</span>
              <span>Hora</span>
            </div>
            <div class="divide-y divide-dark-border/50">
              <div class="grid grid-cols-4 gap-2 px-3 py-2 text-xs">
                <span class="font-mono text-white">#4821</span>
                <span class="text-gray-text">Carlos M.</span>
                <span><span class="rounded-full bg-green-500/15 px-1.5 py-0.5 text-[10px] text-green-400">Entregado</span></span>
                <span class="text-gray-text">14:32</span>
              </div>
              <div class="grid grid-cols-4 gap-2 px-3 py-2 text-xs">
                <span class="font-mono text-white">#4822</span>
                <span class="text-gray-text">Ana R.</span>
                <span><span class="rounded-full bg-blue-500/15 px-1.5 py-0.5 text-[10px] text-blue-400">En ruta</span></span>
                <span class="text-gray-text">14:45</span>
              </div>
              <div class="grid grid-cols-4 gap-2 px-3 py-2 text-xs">
                <span class="font-mono text-white">#4823</span>
                <span class="text-gray-text">Luis P.</span>
                <span><span class="rounded-full bg-yellow-500/15 px-1.5 py-0.5 text-[10px] text-yellow-400">Pendiente</span></span>
                <span class="text-gray-text">15:01</span>
              </div>
              <div class="grid grid-cols-4 gap-2 px-3 py-2 text-xs">
                <span class="font-mono text-white">#4824</span>
                <span class="text-gray-text">Maria G.</span>
                <span><span class="rounded-full bg-green-500/15 px-1.5 py-0.5 text-[10px] text-green-400">Entregado</span></span>
                <span class="text-gray-text">15:18</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
